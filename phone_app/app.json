{
  "expo": {
    "name": "Moo",
    "slug": "moo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.moomoo.phoneai",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Moo AI talks to your Moo storyteller on your home network.",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": []
      }
    },
    "plugins": [
      "react-native-blob-util",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "android": {
      "package": "ca.moomoo.phoneai",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d30f2696-7bd0-4068-b210-68a692fdef04"
      }
    },
    "owner": "philipn1s-team"
  }
}
