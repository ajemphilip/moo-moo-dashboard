#!/usr/bin/env python3
"""moo-status — quick health check.

Reports config presence, assistant service state, recent log lines, and
hardware reachability (ESP32 serial, sounddevice). Useful for support
debugging when something isn't working.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import config as moo_config  # noqa: E402

ASSISTANT_UNIT = "moo-assistant.service"


def main() -> int:
    print()
    print("┌─────────────────────────────────────────┐")
    print("│   Moo status                            │")
    print("└─────────────────────────────────────────┘")
    print()
    section_config()
    section_service()
    section_audio()
    section_recent_logs()
    return 0


def section_config() -> None:
    print("Config")
    cfg = moo_config.load_config()
    if not cfg:
        print(f"  ✗ No config at {moo_config.CONFIG_PATH}")
        print("  → Run moo-setup to add your OpenAI key.")
        print()
        return
    redacted = moo_config.redact(cfg)
    print(f"  ✓ {moo_config.CONFIG_PATH}")
    print(f"    openai_api_key: {redacted.get('openai_api_key', '(missing)')}")
    prefs = cfg.get("preferences") or {}
    print(f"    voice: {prefs.get('tts_voice', '(default)')}")
    print(f"    age_range: {prefs.get('age_range', '(default)')}")
    print(f"    volume: {prefs.get('volume', '(default)')}")
    print(f"    configured_at: {cfg.get('configured_at', '(unknown)')}")
    print()


def section_service() -> None:
    print("Service")
    state = run(["systemctl", "is-active", ASSISTANT_UNIT])
    enabled = run(["systemctl", "is-enabled", ASSISTANT_UNIT])
    icon = "✓" if state == "active" else "✗"
    print(f"  {icon} {ASSISTANT_UNIT}: {state} ({enabled})")
    print()


def section_audio() -> None:
    print("Audio devices")
    try:
        import sounddevice as sd

        devs = sd.query_devices()
        if not devs:
            print("  ✗ No audio devices found")
        else:
            for i, d in enumerate(devs):
                tag_in = "in" if d.get("max_input_channels", 0) > 0 else "  "
                tag_out = "out" if d.get("max_output_channels", 0) > 0 else "   "
                print(f"  [{i}] {tag_in} {tag_out}  {d.get('name')}")
    except Exception as exc:
        print(f"  ✗ sounddevice error: {exc}")
    print()


def section_recent_logs() -> None:
    print("Recent assistant logs (last 10 lines)")
    out = run(["journalctl", "-u", ASSISTANT_UNIT, "-n", "10", "--no-pager", "--output=short"])
    if not out:
        print("  (no recent logs)")
    else:
        for line in out.splitlines():
            print(f"  {line}")
    print()


def run(cmd: list[str]) -> str:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=5, check=False
        ).stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""


if __name__ == "__main__":
    sys.exit(main())
