[Unit]
Description=Moo Setup Service
After=network.target

[Service]
Type=simple
User=philipn1
Group=philipn1
SupplementaryGroups=audio gpio i2c
WorkingDirectory=/opt/moo/pi
Environment=PATH=/opt/moo/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/moo/pi
Environment=MOO_CONFIG_PATH=/etc/moo/config.json
ExecStart=/opt/moo/venv/bin/python -m setup_service.serve
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
