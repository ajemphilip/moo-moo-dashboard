# /etc/sudoers.d/moo-setup
# Narrow NOPASSWD allowlist for the moo-setup service. Install with mode 0440.

philipn1 ALL=(root) NOPASSWD: /usr/bin/systemctl start moo-assistant.service
philipn1 ALL=(root) NOPASSWD: /usr/bin/systemctl stop moo-assistant.service
philipn1 ALL=(root) NOPASSWD: /usr/bin/systemctl restart moo-assistant.service
philipn1 ALL=(root) NOPASSWD: /usr/sbin/iw dev wlan0 scan
philipn1 ALL=(root) NOPASSWD: /usr/sbin/comitup-cli d
philipn1 ALL=(root) NOPASSWD: /usr/sbin/comitup-cli m *
philipn1 ALL=(root) NOPASSWD: /usr/bin/journalctl -u moo-setup.service -n * --no-pager --output=short-iso
philipn1 ALL=(root) NOPASSWD: /usr/bin/journalctl -u moo-assistant.service -n * --no-pager --output=short-iso
philipn1 ALL=(root) NOPASSWD: /usr/local/sbin/moo-offline on
philipn1 ALL=(root) NOPASSWD: /usr/local/sbin/moo-offline off
